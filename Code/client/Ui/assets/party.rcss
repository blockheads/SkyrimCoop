#party {
    position: absolute;
    top: 36dp;
    left: 36dp;
    width: 280dp;
    font-family: Liberation Sans;
    font-weight: 400;
}
.member { display: flex; align-items: center; margin-bottom: 12dp; }
.mood { display: block; width: 54dp; height: 50dp; margin-right: 12dp; }
.member.dead .mood { width: 48dp; height: 50dp; margin-left: 3dp; margin-right: 15dp; }
.player-info { flex-grow: 1; }
.name { font-size: 20dp; }
.level { margin-top: 4dp; font-size: 14dp; font-weight: 700; color: #ffd700; }
.status { color: #c0c0c0; font-weight: 400; }
.member.away { opacity: 0.5; }

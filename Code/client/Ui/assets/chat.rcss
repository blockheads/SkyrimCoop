#chat {
    position: absolute;
    left: 36dp;
    bottom: 120dp;
    width: 500dp;
}
.line { line-height: 1.1; margin-bottom: 0; }
.line .name { margin-right: 7dp; }
.line.system .text { color: #c0c0c0; }
.line.perished .text { color: #ff4c4c; }
.entry { margin-top: 4dp; line-height: 1.1; }
.prompt { margin-right: 7dp; }
.caret {
    display: inline-block;
    width: 1dp;
    height: 17dp;
    background-color: #f5f5f5;
    animation: 0.5s linear infinite alternate blink;
}
@keyframes blink { from { opacity: 1; } to { opacity: 0; } }

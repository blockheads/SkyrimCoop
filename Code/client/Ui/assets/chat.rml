<rml>
<head>
    <title>Party Chat</title>
    <link type="text/rcss" href="skyrim.rcss"/>
    <link type="text/rcss" href="aol-text.rcss"/>
    <link type="text/rcss" href="chat.rcss"/>
</head>
<body data-model="chat">
    <div id="chat" data-if="open || lines.size > 0" data-class-open="open">
        <div class="chat-log">
            <div data-for="line : lines"><div class="line" data-class-system="line.system" data-class-perished="line.perished">
                <span class="name speaker" data-if="!line.perished" data-style-color="line.color">{{ line.system ? 'OnlineHost:' : line.name + ':' }}</span>
                <span class="text">{{ line.text }}</span>
            </div></div>
        </div>
        <div class="entry" data-if="open">
            <span class="prompt speaker">&gt;</span><span class="draft">{{ draft }}</span><span class="caret"></span>
        </div>
    </div>
</body>
</rml>

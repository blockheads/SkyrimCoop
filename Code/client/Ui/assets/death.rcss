body { width: 100%; height: 100%; pointer-events: none; }
#death {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 84dp;
    text-align: center;
    line-height: 1.1;
}
.hint { margin-top: 4dp; color: #c0c0c0; }

/* The leash's warning: a dark red band between two rails, heavy slanted white capitals, a hazard sign at its end. */
#leash {
    position: absolute;
    left: 50%;
    width: 920dp;
    margin-left: -460dp;
    top: 150dp;
    font-family: Liberation Sans;
    font-weight: bold;
    font-style: italic;
    color: #ffffff;
    font-effect: shadow(2dp 2dp #00000090);
}
#leash .rail { height: 5dp; background-color: #7a1c14; }
#leash .band {
    margin: 5dp 0;
    height: 116dp;
    background-color: #6e1a12;
}
#leash .words { margin-right: 136dp; padding-top: 16dp; text-align: right; white-space: nowrap; }
#leash .small { font-size: 26dp; line-height: 32dp; }
#leash .big { font-size: 44dp; line-height: 54dp; }
#leash .sign {
    position: absolute;
    right: 16dp;
    top: 23dp;
    width: 104dp;
    height: 90dp;
    border-radius: 8dp;
    background-color: #1c1616;
}
/* A triangle from borders: only the bottom one is drawn. */
#leash .triangle {
    position: absolute;
    left: 14dp;
    top: 10dp;
    width: 0;
    height: 0;
    border-width: 0 38dp 68dp 38dp;
    border-color: transparent transparent #e8f21c transparent;
}
#leash .mark {
    position: absolute;
    left: 0;
    top: 24dp;
    width: 104dp;
    text-align: center;
    color: #1c1616;
    font-style: normal;
    font-size: 46dp;
    line-height: 50dp;
    font-effect: none;
}

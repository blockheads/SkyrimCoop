# clangd over build/compile_commands.json (scripts/compile_commands.sh): the clang-cl plugin build, plus the Linux
# build's tests. xmake hands clang-cl the Windows SDK and MSVC headers through the environment, which clangd does
# not see.
CompileFlags:
  CompilationDatabase: build
  # Precompiled headers are the build's; clangd makes its own preambles.
  Remove: [-Yu*, -Yc*, -Fp*, /Yu*, /Yc*, /Fp*]
---
If:
  PathExclude: [Code/tests/.*]
CompileFlags:
  Add: [/winsysroot, build/toolchains/winsysroot]

# Dockerfile for building Windows binaries with MSVC via Wine
# Based on mstorsjo/msvc-wine - runs real Microsoft compiler on Linux
# Produces true MSVC binaries that work with Skyrim

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all

# Install Wine and dependencies
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    unzip \
    ca-certificates \
    python3 \
    python3-pip \
    msitools \
    wine \
    wine32 \
    wine64 \
    winbind \
    && rm -rf /var/lib/apt/lists/*

# Install XMake
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:${PATH}"
ENV XMAKE_ROOT=y

# Clone msvc-wine for MSVC setup scripts
RUN git clone https://github.com/mstorsjo/msvc-wine.git /opt/msvc-wine

# Download and install MSVC + Windows SDK using msvc-wine
# This downloads official Microsoft components
RUN cd /opt/msvc-wine && \
    ./vsdownload.py --accept-license --dest /opt/msvc && \
    ./install.sh /opt/msvc

# Set up environment for MSVC
ENV MSVC_ROOT=/opt/msvc
ENV PATH="/opt/msvc-wine:${PATH}"

# Pre-update XMake repositories
RUN xmake repo --update

WORKDIR /workspace

CMD ["/bin/bash"]

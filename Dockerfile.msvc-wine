# Dockerfile for building Windows binaries with MSVC via Wine
# Based on mstorsjo/msvc-wine - runs real Microsoft compiler on Linux
# Produces true MSVC binaries that work with Skyrim

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEDEBUG=-all

# Install Wine and dependencies
RUN dpkg --add-architecture i386 && \
    apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    unzip \
    ca-certificates \
    python3 \
    python3-pip \
    msitools \
    wine \
    wine32 \
    wine64 \
    winbind \
    && rm -rf /var/lib/apt/lists/*

# Install git and other build tools
# NASM is required for OpenSSL assembly optimizations
RUN apt-get update && apt-get install -y git cmake ninja-build nasm unzip && rm -rf /var/lib/apt/lists/*

# Install protoc 26.1 to match XMake's protobuf-cpp package version
# This allows the protobuf.cpp rule to find protoc without complex workarounds
RUN cd /tmp && \
    wget https://github.com/protocolbuffers/protobuf/releases/download/v26.1/protoc-26.1-linux-x86_64.zip && \
    unzip protoc-26.1-linux-x86_64.zip -d /usr/local && \
    rm protoc-26.1-linux-x86_64.zip && \
    chmod +x /usr/local/bin/protoc

# Install Linux XMake for package management (separate from Wine version)
RUN curl -fsSL https://xmake.io/shget.text | bash
ENV PATH="/root/.local/bin:${PATH}"
ENV XMAKE_ROOT=y

# Clone msvc-wine for MSVC setup scripts
RUN git clone https://github.com/mstorsjo/msvc-wine.git /opt/msvc-wine

# Initialize Wine first (creates ~/.wine directory)
RUN wineboot --init && \
    while pgrep wineserver > /dev/null; do sleep 1; done

# Download and install MSVC + Windows SDK using msvc-wine
# This downloads official Microsoft components
RUN cd /opt/msvc-wine && \
    ./vsdownload.py --accept-license --dest /opt/msvc && \
    ./install.sh /opt/msvc

# Set up environment for MSVC
ENV MSVC_ROOT=/opt/msvc
ENV PATH="/opt/msvc-wine:${PATH}"

# Make NASM available to Wine build processes
# Wine needs to find nasm.exe, but we have Linux nasm, so symlink it
RUN ln -sf /usr/bin/nasm /opt/msvc/bin/x64/nasm.exe || true

# Note: We don't pre-update XMake repos here because XMake running in Wine
# requires a project directory with xmake.lua. Repos will auto-update on first use.

WORKDIR /workspace

CMD ["/bin/bash"]
